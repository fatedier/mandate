{
  "name": "mandate",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev",
    "dev": "concurrently -k -n api,web \"bun:dev:server\" \"bun:dev:client\"",
    "dev:server": "MANDATE_DATA_DIR=${MANDATE_DATA_DIR:-~/.mandate-dev} PORT=${PORT:-4174} bun --watch src/server/server.ts serve",
    "dev:client": "MANDATE_API_PORT=${MANDATE_API_PORT:-${PORT:-4174}} bun run --bun vite --host 127.0.0.1",
    "typecheck": "bun run --bun tsc --noEmit",
    "typecheck:server": "bun run --bun tsc -p tsconfig.server.json",
    "typecheck:tests": "bun run --bun tsc -p tsconfig.tests.json",
    "build": "bun run typecheck && bun run --bun vite build",
    "build:binary": "bun run typecheck && bun scripts/build-binary.ts",
    "tauri": "bunx --bun --no-install tauri",
    "tauri:build": "bun src-tauri/scripts/tauri-build.ts",
    "tauri:dev": "bunx --bun --no-install tauri dev",
    "tauri:sidecar": "bun src-tauri/scripts/prepare-sidecar.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write src tests",
    "test": "bun test --preload ./tests/setup.ts --parallel --timings=tests/timings.json tests/",
    "test:timings": "bun test --preload ./tests/setup.ts --parallel --timings=tests/timings.json --update-timings tests/",
    "test:e2e": "docker compose -f e2e/docker-compose.yml run --rm --build tests",
    "test:e2e:shell": "docker compose -f e2e/docker-compose.yml run --rm --build tests bash",
    "test:e2e:run": "bun e2e/run.ts",
    "test:e2e:timings": "docker compose -f e2e/docker-compose.yml run --rm --build tests bun e2e/run.ts --update-timings && cp e2e/.artifacts/e2e-timings.json e2e/timings.json",
    "smoke": "./scripts/smoke.sh"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/google": "^4.0.106",
    "@ai-sdk/open-responses": "2.0.74",
    "@ai-sdk/openai": "^4.0.103",
    "@ai-sdk/provider-utils": "^5.0.69",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@openrouter/sdk": "1.4.25",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@use-gesture/react": "^10.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.154",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "defuddle": "0.19.5",
    "diff": "^9.0.0",
    "eventsource-parser": "^3.1.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.7",
    "html-encoding-sniffer": "7.0.0",
    "jsonrepair": "^3.15.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.45.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-cjk-friendly": "2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "string-width": "^7.2.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  }
}
