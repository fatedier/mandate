{
  "server": {
    "port": 4173
  },
  "panes": {
    "pollIntervalMs": 2000,
    "captureLines": 120
  },
  "logging": {
    "level": "info"
  },
  "models": {
    "default": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "provider-default",
      "fallbacks": [
        {
          "model": "openai/gpt-5.4-mini",
          "reasoningEffort": "provider-default"
        }
      ]
    },
    "providers": {
      "openai": {
        "type": "openai",
        "apiKey": "sk-...",
        "models": [
          {
            "id": "gpt-5.5",
            "input": [
              "text",
              "image"
            ],
            "supportsReasoning": true
          },
          {
            "id": "gpt-5.4-mini",
            "input": [
              "text",
              "image"
            ]
          }
        ]
      }
    }
  },
  "agent": {
    "routes": {
      "manager": {
        "model": "openai/gpt-5.5",
        "reasoningEffort": "provider-default",
        "fallbacks": []
      },
      "worker": {
        "model": "openai/gpt-5.5",
        "reasoningEffort": "provider-default",
        "fallbacks": []
      }
    },
    "compaction": {
      "thresholdTokens": 170000
    }
  }
}
